{
  "name": "ziza-dark-theme",
  "displayName": "Ziza Dark Theme",
  "description": "A minimal dark blue theme with a soft pastel syntax palette, easy on the eyes for long coding sessions. Includes Ziza Midnight, a darker version for dark rooms, and Ziza Mist, a softer version with less glare.",
  "version": "0.2.0",
  "publisher": "ziza",
  "license": "MIT",
  "icon": "imgs/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run build:themes",
    "build:themes": "node scripts/build-themes.mjs",
    "check": "node scripts/check-contrast.mjs"
  },
  "categories": [
    "Themes"
  ],
  "galleryBanner": {
    "color": "#171c28",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zizaaa/zizaVsCodeTheme.git"
  },
  "homepage": "https://zizadarktheme.weteon.com",
  "bugs": {
    "url": "https://github.com/zizaaa/zizaVsCodeTheme/issues"
  },
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "dark theme",
    "dark blue",
    "blue",
    "minimal",
    "pastel",
    "night",
    "ziza",
    "ziza theme",
    "ziza dark",
    "midnight",
    "mist"
  ],
  "contributes": {
    "themes": [
      {
        "id": "ziza theme",
        "label": "Ziza Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/ziza-color-theme.json"
      },
      {
        "id": "ziza-midnight",
        "label": "Ziza Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/ziza-midnight-color-theme.json"
      },
      {
        "id": "ziza-mist",
        "label": "Ziza Mist",
        "uiTheme": "vs-dark",
        "path": "./themes/ziza-mist-color-theme.json"
      }
    ]
  }
}
