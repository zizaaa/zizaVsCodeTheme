	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#98a9ce"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"string constant.other.placeholder"
			],
			"settings": {
				"foreground": "#ffa6a6"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#ffa6a6"
			}
		},
		{
			"name": "Keyword, Storage",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#d5bdff"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword.operator.relational",
				"keyword.operator.assignment",
				"keyword.operator.arithmetic",
				"keyword.operator.logical"
			],
			"settings": {
				"foreground": "#ecd3a4f1"
			}
		},
		{
			"name": "Operator, Misc",
			"scope": [
				"constant.other.color",
				"punctuation",
				"punctuation.definition.tag",
				"punctuation.definition.tag.html",
				"punctuation.definition.tag.begin.html",
				"punctuation.definition.tag.end.html",
				"punctuation.separator.inheritance.php",
				"punctuation.section.embedded",
				"keyword.other.template",
				"keyword.other.substitution"
			],
			"settings": {
				"foreground": "#b4c2e0ab"
			}
		},
		{
			"name": "normal text",
			"scope": [
				"meta.tag"
			],
			"settings": {
				"foreground": "#d9d9d9ee"
			}
		},
		{
			"name": "edited Operator, Misc",
			"scope": [
				"keyword.control"
			],
			"settings": {
				"foreground": "#d5bdff"
			}
		},
		{
			"name": "conditional",
			"scope": [
				"keyword.control.conditional"
			],
			"settings": {
				"foreground": "#fdb794"
			}
		},
		{
			"name": "meta object-literal",
			"scope": [
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#fdb794"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml",
				"markup.deleted.git_gutter"
			],
			"settings": {
				"foreground": "#ffa6a6"
			}
		},
		{
			"name": "Function, Special Method",
			"scope": [
				"meta.function-call",
				"variable.function",
				"support.function",
				"keyword.other.special-method"
			],
			"settings": {
				"foreground": "#a3c7ff"
			}
		},
		{
			"name": "edited Block Level Variables",
			"scope": [
				"variable.other.object",
				"meta.block variable.other"
			],
			"settings": {
				"foreground": "#c2c9d9"
			}
		},
		{
			"name": "Other Variable, String Link",
			"scope": [
				"support.other.variable",
				"string.other.link"
			],
			"settings": {
				"foreground": "#ffa6a6"
			}
		},
		{
			"name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
			"scope": [
				"constant.numeric",
				"constant.language",
				"support.constant",
				"constant.character",
				"constant.escape",
				"variable.parameter",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#fdb794"
			}
		},
		{
			"name": "String, Symbols, Inherited Class, Markup Heading",
			"scope": [
				"string",
				"constant.other.symbol",
				"constant.other.key",
				"entity.other.inherited-class",
				"markup.inserted.git_gutter",
				"meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
			],
			"settings": {
				"foreground": "#b6db9eda"
			}
		},
		{
			"name": "Class, Support",
