	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#9eb2dc"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"string constant.other.placeholder"
			],
			"settings": {
				"foreground": "#ffb3b4"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#ffb3b4"
			}
		},
		{
			"name": "Keyword, Storage",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#e1c6ff"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword.operator.relational",
				"keyword.operator.assignment",
				"keyword.operator.arithmetic",
				"keyword.operator.logical"
			],
			"settings": {
				"foreground": "#f0d49ef1"
			}
		},
		{
			"name": "Operator, Misc",
			"scope": [
				"constant.other.color",
				"punctuation",
				"punctuation.definition.tag",
				"punctuation.definition.tag.html",
				"punctuation.definition.tag.begin.html",
				"punctuation.definition.tag.end.html",
				"punctuation.separator.inheritance.php",
				"punctuation.section.embedded",
				"keyword.other.template",
				"keyword.other.substitution"
			],
			"settings": {
				"foreground": "#c3cadaab"
			}
		},
		{
			"name": "normal text",
			"scope": [
				"meta.tag"
			],
			"settings": {
				"foreground": "#dbdbdbee"
			}
		},
		{
			"name": "edited Operator, Misc",
			"scope": [
				"keyword.control"
			],
			"settings": {
				"foreground": "#e1c6ff"
			}
		},
		{
			"name": "conditional",
			"scope": [
				"keyword.control.conditional"
			],
			"settings": {
				"foreground": "#ffc29a"
			}
		},
		{
			"name": "meta object-literal",
			"scope": [
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#ffc29a"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml",
				"markup.deleted.git_gutter"
			],
			"settings": {
				"foreground": "#ffb3b4"
			}
		},
		{
			"name": "Function, Special Method",
			"scope": [
				"meta.function-call",
				"variable.function",
				"support.function",
				"keyword.other.special-method"
			],
			"settings": {
				"foreground": "#a9d1ff"
			}
		},
		{
			"name": "edited Block Level Variables",
			"scope": [
				"variable.other.object",
				"meta.block variable.other"
			],
			"settings": {
				"foreground": "#c3cbdd"
			}
		},
		{
			"name": "Other Variable, String Link",
