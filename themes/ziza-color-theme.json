	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#7083ad"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"string constant.other.placeholder"
			],
			"settings": {
				"foreground": "#e78284"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#e78284"
			}
		},
		{
			"name": "Keyword, Storage",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#c3a6ff"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword.operator.relational",
				"keyword.operator.assignment",
				"keyword.operator.arithmetic",
				"keyword.operator.logical"
			],
			"settings": {
				"foreground": "#e5c890F1"
			}
		},
		{
			"name": "Operator, Misc",
			"scope": [
				"constant.other.color",
				"punctuation",
				"punctuation.definition.tag",
				"punctuation.definition.tag.html",
				"punctuation.definition.tag.begin.html",
				"punctuation.definition.tag.end.html",
				"punctuation.separator.inheritance.php",
				"punctuation.section.embedded",
				"keyword.other.template",
				"keyword.other.substitution"
			],
			"settings": {
				"foreground": "#8695b7ab"
			}
		},
		{
			"name": "normal text",
			"scope": [
				"meta.tag"
			],
			"settings": {
				"foreground": "#dcdcdcee"
			}
		},
		{
			"name": "edited Operator, Misc",
			"scope": [
				"keyword.control"
			],
			"settings": {
				"foreground": "#c3a6ff"
			}
		},
		{
			"name": "conditional",
			"scope": [
				"keyword.control.conditional"
			],
			"settings": {
				"foreground": "#ef9f76"
			}
		},
		{
			"name": "meta object-literal",
			"scope": [
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#ef9f76"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml",
				"markup.deleted.git_gutter"
			],
			"settings": {
				"foreground": "#e78284"
			}
		},
		{
			"name": "Function, Special Method",
			"scope": [
				"meta.function-call",
				"variable.function",
				"support.function",
				"keyword.other.special-method"
			],
			"settings": {
				"foreground": "#82AAFF"
			}
		},
		{
			"name": "edited Block Level Variables",
			"scope": [
				"variable.other.object",
				"meta.block variable.other"
			],
			"settings": {
				"foreground": "#a2aabc"
			}
		},
		{
			"name": "Other Variable, String Link",
			"scope": [
				"support.other.variable",
				"string.other.link"
			],
			"settings": {
				"foreground": "#e78284"
			}
		},
		{
			"name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
			"scope": [
				"constant.numeric",
				"constant.language",
				"support.constant",
				"constant.character",
				"constant.escape",
				"variable.parameter",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#ef9f76"
			}
		},
		{
			"name": "String, Symbols, Inherited Class, Markup Heading",
			"scope": [
				"string",
				"constant.other.symbol",
				"constant.other.key",
				"entity.other.inherited-class",
				"markup.inserted.git_gutter",
				"meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
			],
			"settings": {
				"foreground": "#a6d189da"
			}
		},
		{
			"name": "Class, Support",
			"scope": [
				"entity.name",
