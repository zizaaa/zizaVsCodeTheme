			"settings": {
				"foreground": "#e78284"
			}
		},
		{
			"name": "Language methods",
			"scope": [
				"variable.language"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#e78284"
			}
		},
		{
			"name": "Method definitions",
			"scope": [
				"entity.name.method",
